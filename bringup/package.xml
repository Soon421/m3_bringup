<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>m3_bringup</name>
  <version>0.1.0</version>
  <description>Top-level bringup launches for ISR-M3 (sensors + robot base).</description>
  <maintainer email="isr3856@gmail.com">isrsoon</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <exec_depend>m3_driver</exec_depend>
  <exec_depend>velodyne_driver</exec_depend>
  <exec_depend>velodyne_pointcloud</exec_depend>
  <exec_depend>velodyne_laserscan</exec_depend>
  <exec_depend>xsens_mti_ros2_driver</exec_depend>
  <exec_depend>novatel_oem7_driver</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
